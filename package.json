    "build:all": "eas build --platform all"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-device": "~6.0.2",
    "expo-application": "~5.9.1",
    "expo-av": "~14.0.7",
    "expo-screen-capture": "~6.0.1",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  }
