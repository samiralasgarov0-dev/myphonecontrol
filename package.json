{
  "name": "myphonecontrol",
  "version": "1.0.0",
  "description": "50 Telefonun Merkezden Kontrolü - Mobile Agent",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build --platform android --type apk",
    "build:aab": "eas build --platform android --type app-bundle",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit": "eas submit --platform android",
    "eject": "expo eject"
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-device": "^6.0.2",
    "expo-application": "^5.9.1",
    "expo-av": "^14.0.5",
    "expo-screen-capture": "^6.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "eas-cli": "^8.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=16.0.0"
  }
}
