{
  "name": "myphonecontrol",
  "version": "1.0.0",
  "description": "50 Telefonun Merkezden Kontrolü - Mobile Agent",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build --platform android --profile preview",
